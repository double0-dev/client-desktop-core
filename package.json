    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "aws4fetch": "^1.0.20",
    "drizzle-kit": "1.0.0-beta.20",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^31.0.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "neverBuiltDependencies": [],
    "packageExtensions": {
      "drizzle-orm": {
        "peerDependenciesMeta": {
          "mssql": {
            "optional": true
          },
          "@types/mssql": {
            "optional": true
          }
        }
      }
    },
    "patchedDependencies": {
      "@homebridge/node-pty-prebuilt-multiarch@0.13.1": "patches/@homebridge__node-pty-prebuilt-multiarch@0.13.1.patch",
      "@xterm/addon-webgl@0.19.0": "patches/@xterm__addon-webgl@0.19.0.patch"
    }
  }
}
