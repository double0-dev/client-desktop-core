{
  "name": "double0-desktop",
  "version": "0.8.4",
  "license": "Apache-2.0",
  "description": "double0 desktop client (Electron + TanStack Router)",
  "main": "./out/main/index.js",
  "desktopName": "double0-desktop.desktop",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "author": "double0",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run routes:generate && pnpm run typecheck:node && pnpm run typecheck:web",
    "typecheck:core": "pnpm run routes:generate && tsc --noEmit -p tsconfig.core.node.json --composite false && tsc --noEmit -p tsconfig.core.web.json --composite false",
    "test": "vitest run",
    "test:core": "node scripts/core-run.mjs vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "quality": "pnpm quality:pro && pnpm typecheck:core && pnpm test:core",
    "quality:pro": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "quality:core": "pnpm typecheck:core && pnpm lint && pnpm format:check && pnpm test:core",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"src/**/*.{ts,tsx}\" \"pro/**/*.{ts,tsx}\" \"scripts/**/*.{mjs,mts}\" \"pro/scripts/**/*.{mjs,mts}\" .github",
    "routes:generate": "tsr generate",
    "routes:watch": "tsr watch",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "dev:core": "node scripts/core-run.mjs electron-vite dev",
    "build": "pnpm run typecheck && pnpm run test && electron-vite build && node scripts/extension-step.mjs scripts/check-remote-runtime.mjs --allow-missing-downloads",
    "build:core": "pnpm run typecheck:core && pnpm run test:core && node scripts/core-run.mjs electron-vite build",
    "package:core": "pnpm run build:core && electron-builder --config electron-builder.core.yml && node scripts/check-app-asar.mjs --core",
    "package:core:dir": "pnpm run build:core && electron-builder --config electron-builder.core.yml --dir && node scripts/check-app-asar.mjs --core",
    "postinstall": "electron-builder install-app-deps && node scripts/dev-app-icon.mjs",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "pnpm run build && electron-builder --mac",
    "build:linux": "pnpm run build && electron-builder --linux",
    "build:all": "pnpm run build && electron-builder -mwl",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@codingame/monaco-vscode-api": "39.0.4",
    "@codingame/monaco-vscode-configuration-service-override": "39.0.4",
    "@codingame/monaco-vscode-cpp-default-extension": "39.0.4",
    "@codingame/monaco-vscode-css-default-extension": "39.0.4",
    "@codingame/monaco-vscode-dart-default-extension": "39.0.4",
    "@codingame/monaco-vscode-editor-api": "39.0.4",
    "@codingame/monaco-vscode-editor-service-override": "39.0.4",
    "@codingame/monaco-vscode-extensions-service-override": "39.0.4",
    "@codingame/monaco-vscode-files-service-override": "39.0.4",
    "@codingame/monaco-vscode-html-default-extension": "39.0.4",
    "@codingame/monaco-vscode-java-default-extension": "39.0.4",
    "@codingame/monaco-vscode-javascript-default-extension": "39.0.4",
    "@codingame/monaco-vscode-json-default-extension": "39.0.4",
    "@codingame/monaco-vscode-languages-service-override": "39.0.4",
    "@codingame/monaco-vscode-log-service-override": "39.0.4",
    "@codingame/monaco-vscode-markdown-basics-default-extension": "39.0.4",
    "@codingame/monaco-vscode-model-service-override": "39.0.4",
    "@codingame/monaco-vscode-php-default-extension": "39.0.4",
    "@codingame/monaco-vscode-python-default-extension": "39.0.4",
    "@codingame/monaco-vscode-rust-default-extension": "39.0.4",
    "@codingame/monaco-vscode-shellscript-default-extension": "39.0.4",
    "@codingame/monaco-vscode-standalone-css-language-features": "39.0.4",
    "@codingame/monaco-vscode-standalone-html-language-features": "39.0.4",
    "@codingame/monaco-vscode-standalone-json-language-features": "39.0.4",
