{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "pro/main/**/*",
    "pro/preload/**/*",
    "pro/daemon/**/*"
  ],
  "compilerOptions": {
    "moduleResolution": "bundler",
    "composite": true,
    "noImplicitAny": true,
    "types": ["electron-vite/node"],
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"],
      "@main/*": ["./src/main/*"],
      "@pro/main": ["./pro/main/index.ts", "./src/pro-stub/main.ts"],
      "@pro/preload": ["./pro/preload/index.ts", "./src/pro-stub/preload.ts"],
      "@pro/daemon": ["./pro/daemon/index.ts", "./src/pro-stub/daemon.ts"]
    }
  }
}
